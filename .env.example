# Copy this file to .env and fill in your real values.
# Never commit .env or paste its contents anywhere public.

# Gmail address to connect to
GMAIL_USER=

# 16-character Gmail App Password (requires 2FA enabled on the account)
# Generate one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# IMAP connection (defaults shown, override only if needed)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Mailboxes to scan:
#   *          — all mail (Gmail: [Gmail]/All Mail, covers every label)
#   INBOX      — inbox only
#   Label A,B  — comma-separated list of specific labels
IMAP_LABELS=*

# Scan tuning
IMAP_SINCE_DAYS=730
IMAP_MAX_MESSAGES=10000

# HTTP server port
PORT=8420
