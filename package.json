{
  "name": "docket",
  "version": "1.0.0",
  "private": true,
  "description": "Docket — Gmail document archive (read-only IMAP backend)",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently -k -n api,web -c blue,green \"node backend/server.js\" \"npm run dev --prefix packages/frontend\"",
    "build": "npm run build --prefix packages/frontend",
    "dev:web": "npm run dev --prefix packages/frontend"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^9.2.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
